{
  "name": "proxycost",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "weights:fetch": "node scripts/shopify-probe.mjs",
    "weights:build": "tsx scripts/weights-build.ts",
    "weights:coverage": "tsx scripts/weights-coverage.ts",
    "corpus:harvest": "tsx scripts/corpus/harvest.ts",
    "corpus:merge": "tsx scripts/corpus/merge.ts",
    "fees:check": "tsx scripts/fees-check.ts",
    "sites:fetch": "tsx scripts/proxy-sites-fetch.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "vitest run && playwright test",
    "preview:build": "node scripts/preview/build.mjs",
    "deeplinks:check": "tsx scripts/deeplinks-check.ts",
    "fx:fetch": "tsx scripts/fx-fetch.ts",
    "ties:scan": "tsx scripts/ties-scan.ts",
    "ledger:indeterminacy": "tsx scripts/indeterminacy-ledger.ts && tsx scripts/indeterminacy-summary.ts && python3 scripts/indeterminacy-xlsx.py --date $(date +%Y-%m-%d)"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@opennextjs/cloudflare": "1.20.6",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.3.3",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^5",
    "wrangler": "4.131.2"
  }
}
